# Every variable docker-compose.yml reads is named here, uncommented when it has
# no default and commented with its default when it has one. A name absent from
# this file reaches a service only through a Compose override. Compose expands
# top to bottom, so a line using ${...} must sit below every name it reads.

AETHERNET_DOMAIN=chat.example.com
AETHERNET_PUBLIC_SCHEME=https
AETHERNET_PUBLIC_PORT=443

# The lines above are the address browsers use, and every advertised endpoint
# carries AETHERNET_PUBLIC_PORT. They do not move what the host publishes.
# AETHERNET_HTTP_PORT and AETHERNET_HTTPS_PORT below do that, and a non-default port
# needs the matching one set as well. Complete recipes sit beside them.

# How browsers reach this instance.
#
# Default: Aethernet binds 80 and 443 and gets its own Let's Encrypt certificate.
# Point DNS at this host.
#
# Behind your own reverse proxy (nginx, Traefik, HAProxy, Cloudflare Tunnel,
# another Caddy): uncomment COMPOSE_FILE below. Aethernet then serves plain HTTP on
# 127.0.0.1:8080 instead, and your proxy forwards everything to it. Keep
# AETHERNET_PUBLIC_SCHEME and AETHERNET_PUBLIC_PORT describing the PUBLIC address your
# proxy serves, not this local port.
#COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml

# Where the plain-HTTP port binds when the proxy overlay is in use. Leave it on
# loopback when the proxy runs on this host. Use 0.0.0.0:8080 only when the proxy
# is on another machine, and firewall the port to that machine.
#AETHERNET_EDGE_BIND=127.0.0.1:8080

# Which upstream hops may set X-Forwarded-For. Aethernet rewrites the header from
# this to the real client address, so IP bans, rate limits and abuse detection
# see the caller rather than the proxy. The default covers proxies on private or
# loopback addresses, which is every same-host setup. Set it to your proxy's
# address if it reaches Aethernet from a public IP.
#AETHERNET_EDGE_TRUSTED_PROXIES=private_ranges

# The origin browsers see, without a trailing slash. Leave it unset and each
# service builds one from the three values at the top of this file. Set it and it
# wins: every service reads the host, the scheme and the port out of it and
# ignores those three names. Use it when browsers reach the instance on a host
# AETHERNET_DOMAIN does not name. It has to be a bare origin, a scheme and a host
# and an optional port and nothing after them, or the services refuse to start.
# It does not move the edge listener or the published ports either, so set the
# publish below to the port written here.
#AETHERNET_PUBLIC_ORIGIN=https://chat.example.com

# Overrides the address the edge listens on inside its container. Compose builds
# it from AETHERNET_PUBLIC_SCHEME and AETHERNET_DOMAIN with no port, and the edge keeps
# its container ports at 80 and 443 whatever the public port is. Caddy matches a
# site by host and ignores the port in the Host header, so a request arriving on
# a non-default published port still lands on this site. Put a port in this value
# only if you also publish that same container port below, or nothing will be
# listening where the publish points. Honoured in the default mode only:
# docker-compose.proxy.yml sets the literal :8080 and tunnel.compose.yml the
# literal :80, and Compose lets the last file win, so a value here is discarded
# under either overlay with no warning. Set it for an unusual default-mode
# layout, such as serving several hostnames. Write the scheme into it: a bare
# hostname means automatic HTTPS on 443 whatever AETHERNET_PUBLIC_SCHEME says.
#AETHERNET_EDGE_SITE_ADDRESS=https://chat.example.com

# The old name for the value above, read only when AETHERNET_EDGE_SITE_ADDRESS is
# unset, so an existing .env keeps the listener it already had.
#AETHERNET_CADDY_SITE_ADDRESS=

# Host side of the edge's publishes, and the only names that decide which host
# ports Aethernet binds. The container side is fixed. Container 80 carries the
# HTTP to HTTPS redirect and the Let's Encrypt HTTP challenge under an https
# scheme, and the site itself under an http one. Container 443 carries the TLS
# site. AETHERNET_HTTPS_PORT moves the TCP and the UDP publish together, because
# HTTP/3 needs both on the same port. Both take an optional bind address in front
# of the port, and 127.0.0.1 keeps the publish off every public interface. Give
# them different host ports: the same host port on both is two publishes of one
# port and the edge refuses to start.
#AETHERNET_HTTP_PORT=80
#AETHERNET_HTTPS_PORT=443
#AETHERNET_HTTP_PORT=127.0.0.1:80
#AETHERNET_HTTPS_PORT=127.0.0.1:443

# HTTPS on 8443, complete. Host 80 stays published and still answers the ACME
# challenge. Let's Encrypt only ever connects to the public 80 or 443, so the
# certificate is issued if a router in front forwards public 80 to this host and
# is not issued otherwise. Serve your own certificate from the Caddyfile when it
# cannot.
#AETHERNET_PUBLIC_PORT=8443
#AETHERNET_HTTPS_PORT=8443

# Plain HTTP on 19080, complete. The port 80 publish moves to 19080, so nothing
# binds host 80. Under an http scheme nothing listens on container 443, so the
# last line parks that publish on loopback for a host that wants 443 for
# something else. Drop it and 443 is published and idle, which is what earlier
# releases did.
#AETHERNET_PUBLIC_SCHEME=http
#AETHERNET_PUBLIC_PORT=19080
#AETHERNET_HTTP_PORT=19080
#AETHERNET_HTTPS_PORT=127.0.0.1:443

# A tunnel or another proxy in front of the stack needs no HTTPS publish at all.
# tunnel.compose.yml ships beside this file and replaces Caddy's published ports
# with a single loopback HTTP publish, so nothing binds 443, and points the edge
# at plain HTTP on that publish so it stops redirecting to https. AETHERNET_HTTP_PORT
# still moves that one publish. Set the line below and plain docker compose
# commands pick the file up, or add it to your own -f flags if you pass any. The
# file uses the !override tag, which needs Compose 2.24.4 or newer.
#COMPOSE_FILE=docker-compose.yml:tunnel.compose.yml

AETHERNET_REGISTRY_OWNER=aethernetapp
AETHERNET_REGISTRY=ghcr.io/${AETHERNET_REGISTRY_OWNER}
AETHERNET_IMAGE_TAG=v1

POSTGRES_PASSWORD=CHANGE_ME
MEILI_MASTER_KEY=CHANGE_ME
# The stack ships its own Postgres and its own object store, and points at both
# by service name. Set these to run either one outside the stack. Leave them
# unset and the bundled services are used. Taking a service out of the stack
# means an upgrade skips the backup step that reaches into it, and backing that
# store up belongs to whoever runs it.
#AETHERNET_POSTGRES_HOST=db.example.com
#AETHERNET_POSTGRES_PORT=5432
#AETHERNET_POSTGRES_DATABASE=aethernet
#AETHERNET_POSTGRES_USERNAME=aethernet
#AETHERNET_POSTGRES_SSL=true
#AETHERNET_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
#AETHERNET_S3_PUBLIC_ENDPOINT=https://cdn.example.com
#AETHERNET_S3_REGION=eu-central-1
#AETHERNET_S3_FORCE_PATH_STYLE=false
# Bucket names. The bundled object store creates whichever names these hold, so
# the two stay in step. An object store outside the stack needs the buckets to
# exist already.
#AETHERNET_S3_BUCKET_CDN=aethernet
#AETHERNET_S3_BUCKET_UPLOADS=aethernet-uploads
#AETHERNET_S3_BUCKET_DOWNLOADS=aethernet-downloads
#AETHERNET_S3_BUCKET_REPORTS=aethernet-reports
#AETHERNET_S3_BUCKET_HARVESTS=aethernet-harvests

# The rest of the bundled services, pointed somewhere else the same way. Leave a
# line unset and the service in the stack is used. Taking a service out of the
# stack goes in an override file listed in COMPOSE_FILE, because an upgrade
# replaces docker-compose.yml.
#AETHERNET_KV_URL=redis://cache.example.com:6379/0
#AETHERNET_NATS_URL=nats://mq.example.com:4222
#AETHERNET_NATS_JETSTREAM_URL=nats://mq.example.com:4222
#AETHERNET_SVC_NATS_URL=nats://mq.example.com:4222
#AETHERNET_SEARCH_URL=https://search.example.com
#AETHERNET_LIVEKIT_INTERNAL_URL=http://livekit.example.com:7880

# Voice off. The livekit service still runs until an override file takes it out.
#AETHERNET_LIVEKIT_ENABLED=false

# Optional systems, each off unless the instance is configured for it.
#AETHERNET_SMS_ENABLED=false
#AETHERNET_STRIPE_ENABLED=false
#AETHERNET_NCMEC_ENABLED=false
#AETHERNET_CLAMAV_ENABLED=false

# The client address. Set the header name a proxy in front actually writes, and
# turn the trust off when nothing sits in front, because a trusted header an
# attacker can set is a spoofed client address.
#AETHERNET_CLIENT_IP_HEADER_NAME=cf-connecting-ip
#AETHERNET_TRUST_CLIENT_IP_HEADER=true

# How much the services write. trace, debug, info, warn, error or fatal. Every
# service names the object storage endpoint and its addressing at info on start,
# so a bucket that answers 404 is visible without raising this.
#LOG_LEVEL=debug

AETHERNET_S3_ACCESS_KEY=aethernet
AETHERNET_S3_SECRET_KEY=CHANGE_ME

AETHERNET_SUDO_MODE_SECRET=CHANGE_ME
AETHERNET_CONNECTION_INITIATION_SECRET=CHANGE_ME
AETHERNET_GATEWAY_RPC_AUTH_TOKEN=CHANGE_ME
AETHERNET_ERLANG_COOKIE=CHANGE_ME
AETHERNET_MEDIA_PROXY_SECRET_KEY=CHANGE_ME
AETHERNET_MEDIA_PROXY_UPLOAD_RELAY_SECRET_BASE64=CHANGE_ME
AETHERNET_ADMIN_SECRET_KEY_BASE=CHANGE_ME
AETHERNET_ADMIN_OAUTH_CLIENT_SECRET=CHANGE_ME

# The token every service sends to NATS. The bundled NATS runs without
# authentication, so this stays empty unless a Compose override points the stack
# at an external NATS that requires a token. Compose forwards the name to every
# container that connects.
#AETHERNET_NATS_AUTH_TOKEN=

AETHERNET_VAPID_PUBLIC_KEY=CHANGE_ME
AETHERNET_VAPID_PRIVATE_KEY=CHANGE_ME

# The VAPID contact address defaults to admin@ followed by AETHERNET_DOMAIN. Set it
# only if that mailbox does not exist.
#AETHERNET_VAPID_EMAIL=admin@chat.example.com

# Passkeys follow AETHERNET_DOMAIN by default. Set these only if browsers reach the
# instance on a different host, and note that changing AETHERNET_PASSKEY_RP_ID
# invalidates every passkey already registered against the old value.
#AETHERNET_PASSKEY_RP_ID=chat.example.com
#AETHERNET_PASSKEY_RP_NAME=Aethernet
#AETHERNET_PASSKEY_ADDITIONAL_ALLOWED_ORIGINS=https://chat.example.com
#AETHERNET_PASSKEY_ADDITIONAL_ALLOWED_ORIGINS=http://chat.example.com:19080

# Extra Content-Security-Policy sources, appended to the built-in ones. Set these
# only when a browser must reach an origin the defaults do not cover, such as a
# voice server hosted on a domain other than AETHERNET_DOMAIN. Separate several
# sources with spaces or commas. Every one of them is empty by default, and the
# three carrying a value below are illustrations, not defaults.
#AETHERNET_CSP_EXTRA_DEFAULT_SRC=
#AETHERNET_CSP_EXTRA_CONNECT_SRC=wss://livekit.example.com:7881
#AETHERNET_CSP_EXTRA_IMG_SRC=https://cdn.example.com
#AETHERNET_CSP_EXTRA_MEDIA_SRC=
#AETHERNET_CSP_EXTRA_FONT_SRC=
#AETHERNET_CSP_EXTRA_SCRIPT_SRC=https://analytics.example.com
#AETHERNET_CSP_EXTRA_STYLE_SRC=
#AETHERNET_CSP_EXTRA_FRAME_SRC=
#AETHERNET_CSP_EXTRA_WORKER_SRC=
#AETHERNET_CSP_EXTRA_MANIFEST_SRC=

# One report-uri for Content-Security-Policy violation reports. Empty leaves the
# directive off the header.
#AETHERNET_CSP_REPORT_URI=

# Allow the SSO identity provider to resolve to a private or internal address.
# Off by default: the API refuses to call non-public addresses so a misconfigured
# provider URL cannot be used to reach internal services. Turn it on only when the
# provider genuinely lives on your own network, such as split-horizon DNS or a LAN
# identity provider, and only when you trust everyone who can configure SSO.
#AETHERNET_SSO_ALLOW_PRIVATE_ADDRESSES=true

# Both reach LiveKit as LIVEKIT_KEYS and the webhook signing key, and the API as
# AETHERNET_LIVEKIT_API_KEY and AETHERNET_LIVEKIT_API_SECRET. Change them together.
LIVEKIT_API_KEY=aethernet
LIVEKIT_API_SECRET=CHANGE_ME

# The URL browsers use for voice signalling. Compose builds it from
# AETHERNET_PUBLIC_ORIGIN, or from AETHERNET_PUBLIC_SCHEME, AETHERNET_DOMAIN and
# AETHERNET_PUBLIC_PORT, as that origin followed by /livekit. The client rewrites a
# leading http to ws itself. Set it only when LiveKit is served from another
# host.
#AETHERNET_LIVEKIT_URL=

# Media ports. LiveKit advertises these in ICE candidates, so the host must
# forward the same numbers.
#AETHERNET_LIVEKIT_TCP_PORT=7881
#AETHERNET_LIVEKIT_UDP_PORT=7882

# LiveKit finds the address browsers dial by asking a STUN server. A host that
# cannot reach one over UDP stops with "could not resolve external IP", and the
# address is then set by hand: put it in AETHERNET_LIVEKIT_NODE_IP and set
# AETHERNET_LIVEKIT_USE_EXTERNAL_IP to false. Point the STUN entries at another
# server to keep the lookup and leave Google out of it.
#AETHERNET_LIVEKIT_USE_EXTERNAL_IP=false
#AETHERNET_LIVEKIT_NODE_IP=203.0.113.10
#AETHERNET_LIVEKIT_STUN_PRIMARY=stun.l.google.com:19302
#AETHERNET_LIVEKIT_STUN_SECONDARY=stun1.l.google.com:19302

AETHERNET_KLIPY_API_KEY=

AETHERNET_EMAIL_ENABLED=false
AETHERNET_EMAIL_PROVIDER=none
AETHERNET_EMAIL_FROM_EMAIL=noreply@example.com
AETHERNET_EMAIL_FROM_NAME=Aethernet
AETHERNET_EMAIL_APP_BASE_URL=
AETHERNET_EMAIL_SMTP_HOST=
AETHERNET_EMAIL_SMTP_PORT=587
AETHERNET_EMAIL_SMTP_USERNAME=
AETHERNET_EMAIL_SMTP_PASSWORD=
AETHERNET_EMAIL_SMTP_SECURE=true

AETHERNET_CAPTCHA_ENABLED=false
AETHERNET_CAPTCHA_PROVIDER=none
AETHERNET_CAPTCHA_HCAPTCHA_SITE_KEY=
AETHERNET_CAPTCHA_HCAPTCHA_SECRET_KEY=
AETHERNET_CAPTCHA_TURNSTILE_SITE_KEY=
AETHERNET_CAPTCHA_TURNSTILE_SECRET_KEY=
AETHERNET_DISCOVERY_ENABLED=true

# Container memory. The limits sum to 18.25 GiB, which is a sum of ceilings and
# not an allocation, so the defaults fit a host with 8 GB and are sized for 16 GB.
# The reservations are cgroup memory.low, which biases the kernel away from
# reclaiming from services whose death takes the instance down. They reserve
# nothing. Lower the limits on a smaller host.
# Small hosts: use .env.low-memory.example (~6.2 GB ceilings, ~1.6 GB idle) for
# 4 GB servers, or .env.micro.example (~3.9 GB ceilings, 1–2 GB idle, max 6 GB /
# 3 CPU under load) for 2 vCPU boxes with 30+ mostly-text users.
#AETHERNET_CADDY_MEMORY_LIMIT=256mb
#AETHERNET_POSTGRES_MEMORY_LIMIT=5gb
#AETHERNET_POSTGRES_MEMORY_RESERVATION=3gb
#AETHERNET_VALKEY_MEMORY_LIMIT=256mb
#AETHERNET_NATS_MEMORY_LIMIT=256mb
#AETHERNET_MEILISEARCH_MEMORY_LIMIT=768mb
#AETHERNET_SEAWEEDFS_MEMORY_LIMIT=2gb
#AETHERNET_SEAWEEDFS_INIT_MEMORY_LIMIT=128mb
#AETHERNET_LIVEKIT_MEMORY_LIMIT=512mb
#AETHERNET_API_MEMORY_LIMIT=2560mb
#AETHERNET_API_MEMORY_RESERVATION=1gb
#AETHERNET_WORKER_MEMORY_LIMIT=2560mb
#AETHERNET_WORKER_MEMORY_RESERVATION=1gb
#AETHERNET_GATEWAY_MEMORY_LIMIT=1gb
#AETHERNET_GATEWAY_MEMORY_RESERVATION=384mb
#AETHERNET_MEDIA_PROXY_MEMORY_LIMIT=512mb
#AETHERNET_STATIC_PROXY_MEMORY_LIMIT=256mb
#AETHERNET_APP_PROXY_MEMORY_LIMIT=256mb
#AETHERNET_SNOWFLAKES_MEMORY_LIMIT=128mb
#AETHERNET_SNOWFLAKES_SHARD_MEMORY_LIMIT=256mb
#AETHERNET_USERS_MEMORY_LIMIT=128mb
#AETHERNET_USERS_SHARD_MEMORY_LIMIT=256mb
#AETHERNET_GIFS_MEMORY_LIMIT=128mb
#AETHERNET_GIFS_SHARD_MEMORY_LIMIT=256mb
#AETHERNET_MESSAGES_MEMORY_LIMIT=128mb
#AETHERNET_MESSAGES_SHARD_MEMORY_LIMIT=256mb
#AETHERNET_UNFURL_MEMORY_LIMIT=128mb
#AETHERNET_UNFURL_SHARD_MEMORY_LIMIT=256mb
#AETHERNET_ADMIN_MEMORY_LIMIT=256mb

# Container CPU ceilings (docker `cpus`). Each value throttles one service when
# it bursts; the sum may exceed host CPUs because idle services use ~0. Idle
# stays at 1–2 CPUs with the micro preset; load peaks at ~3 CPUs. Tighten these
# together with the memory limits above on small hosts.
#AETHERNET_CADDY_CPUS_LIMIT=0.50
#AETHERNET_POSTGRES_CPUS_LIMIT=2.0
#AETHERNET_VALKEY_CPUS_LIMIT=0.50
#AETHERNET_NATS_CPUS_LIMIT=0.50
#AETHERNET_MEILISEARCH_CPUS_LIMIT=1.0
#AETHERNET_SEAWEEDFS_CPUS_LIMIT=1.0
#AETHERNET_SEAWEEDFS_INIT_CPUS_LIMIT=0.50
#AETHERNET_LIVEKIT_CPUS_LIMIT=2.0
#AETHERNET_API_CPUS_LIMIT=2.0
#AETHERNET_WORKER_CPUS_LIMIT=2.0
#AETHERNET_GATEWAY_CPUS_LIMIT=2.0
#AETHERNET_MEDIA_PROXY_CPUS_LIMIT=1.0
#AETHERNET_STATIC_PROXY_CPUS_LIMIT=0.50
#AETHERNET_APP_PROXY_CPUS_LIMIT=0.50
#AETHERNET_SNOWFLAKES_CPUS_LIMIT=0.50
#AETHERNET_SNOWFLAKES_SHARD_CPUS_LIMIT=0.50
#AETHERNET_USERS_CPUS_LIMIT=0.50
#AETHERNET_USERS_SHARD_CPUS_LIMIT=0.50
#AETHERNET_GIFS_CPUS_LIMIT=0.50
#AETHERNET_GIFS_SHARD_CPUS_LIMIT=0.50
#AETHERNET_MESSAGES_CPUS_LIMIT=0.50
#AETHERNET_MESSAGES_SHARD_CPUS_LIMIT=0.50
#AETHERNET_UNFURL_CPUS_LIMIT=0.50
#AETHERNET_UNFURL_SHARD_CPUS_LIMIT=0.50
#AETHERNET_ADMIN_CPUS_LIMIT=0.50

# Meilisearch indexing memory. Keep it well under AETHERNET_MEILISEARCH_MEMORY_LIMIT,
# which is the container ceiling the indexer shares with the search process.
#AETHERNET_MEILISEARCH_MAX_INDEXING_MEMORY=384mb

# SeaweedFS heap ceiling. Go collects against this value instead of against the
# container limit, which it cannot see, so without it an upload burst grows the
# heap past AETHERNET_SEAWEEDFS_MEMORY_LIMIT and the kernel OOM-kills the container
# mid-upload (exit 137). Keep it near three quarters of that limit, and raise both
# together: the peak is the parts of one upload in flight at once, which is 25 MB
# times 20 for a 500 MB attachment.
#AETHERNET_SEAWEEDFS_GOMEMLIMIT=1536MiB

# Node sizes its own heap from the container memory limit by default, at roughly
# 55 percent of it, which always leaves room for the buffers and stacks that live
# outside the heap. Leave these unset unless you have a reason to pin the value.
# Any value set here must stay well below the container limit above: a heap ceiling
# above the container limit makes the kernel OOM-kill the container (exit 137, no
# diagnostics) instead of Node reporting a JavaScript heap out of memory error.
#AETHERNET_API_NODE_HEAP_MB=1792
#AETHERNET_WORKER_NODE_HEAP_MB=1792

# Bundled Postgres tuning. Keep these consistent with AETHERNET_POSTGRES_MEMORY_LIMIT:
# budget roughly shared_buffers + (server max_connections x 12 MB) +
# (3 x autovacuum_work_mem) + 300 MB for page cache and WAL. Note this is the
# server setting, distinct from the per-service AETHERNET_POSTGRES_MAX_CONNECTIONS
# pool sizes used by the api, worker and shards.
#AETHERNET_POSTGRES_SERVER_MAX_CONNECTIONS=150
#AETHERNET_POSTGRES_SHARED_BUFFERS=512MB
#AETHERNET_POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
#AETHERNET_POSTGRES_WORK_MEM=8MB
#AETHERNET_POSTGRES_MAINTENANCE_WORK_MEM=256MB
#AETHERNET_POSTGRES_AUTOVACUUM_WORK_MEM=128MB
#AETHERNET_POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
#AETHERNET_POSTGRES_DEFAULT_STATISTICS_TARGET=200
#AETHERNET_POSTGRES_MIN_WAL_SIZE=512MB
#AETHERNET_POSTGRES_MAX_WAL_SIZE=2GB
#AETHERNET_API_POSTGRES_MAX_CONNECTIONS=25
#AETHERNET_WORKER_POSTGRES_MAX_CONNECTIONS=25
#AETHERNET_API_WORKER_LANE_CONCURRENCY_OVERRIDES=

# The bundled Valkey holds durable state as well as cache. The bulk message
# deletion queue and the account deletion queue are sorted sets with no expiry,
# and nothing else stores the first of the two. It therefore runs with an
# append-only file on a named volume and with noeviction, so an over-limit write
# fails loudly instead of silently deleting queued work. Distributed locks all
# carry a TTL and are not what the durability is for. Only change the policy if
# you have moved that durable state elsewhere.
#AETHERNET_VALKEY_MAXMEMORY=192mb
#AETHERNET_VALKEY_MAXMEMORY_POLICY=noeviction

# The gateway derives its BEAM scheduler count from the container CPU quota,
# clamped to this range. The floor matters: a single scheduler lets one blocking
# operation stall every websocket on the node. The ceiling stops a large host
# from starting far more schedulers than the container can actually use.
#AETHERNET_ERLANG_SCHEDULERS_MIN=2
#AETHERNET_ERLANG_SCHEDULERS_MAX=16

# In-flight request ceiling for the services Compose forwards it to: the users
# and messages routers and their shards. Leave it unset and each service uses its
# built-in default. Set it and the one value replaces that default on all of
# them, so size it for the busiest. The built-in defaults are 192 for
# messages, 320 for snowflakes and 64 elsewhere, and they govern every service
# Compose does not forward this to. A router holds a slot for the whole round
# trip to its shard, so this is a ceiling on requests in flight at once and not a
# rate: too low a value does not slow requests down, it rejects them, and the api
# turns that rejection into a 503.
#AETHERNET_SVC_MAX_CONCURRENT_REQUESTS=192

# The api and the Rust services name their fixed Postgres statement shapes so the
# server can reuse their plans. Named prepared statements require a session that
# outlives the transaction, so set this to false if you put a transaction-pooling
# connection pooler such as PgBouncer in front of Postgres. One setting governs
# every service. The bundled compose talks to Postgres directly, where naming is
# a win and the default is correct.
#AETHERNET_POSTGRES_PREPARED_STATEMENTS=true

# The api bounds how long a client may take to send a request. The header timeout
# covers the request line and headers only, while the request timeout covers the
# whole exchange, so a slow uploader is bounded by the second value and not by
# the first. Raise both if you front large uploads or serve clients on high
# latency links. The header timeout is clamped down to the request timeout, so
# raising it alone does nothing. Both are milliseconds, between 1000 and 3600000.
#AETHERNET_API_HEADERS_TIMEOUT_MS=30000
#AETHERNET_API_REQUEST_TIMEOUT_MS=120000
