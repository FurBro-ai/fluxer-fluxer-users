# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Aethernet Canary
GenericName=Instant Messenger
Comment=Canary build of Aethernet
Exec=app.aethernet.AethernetCanary %U
TryExec=app.aethernet.AethernetCanary
Icon=app.aethernet.AethernetCanary
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.aethernet.AethernetCanary
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/aethernet;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.aethernet.AethernetCanary --aethernet-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.aethernet.AethernetCanary --aethernet-task=new-dm %U
