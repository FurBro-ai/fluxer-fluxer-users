# Checked-in local development defaults. Private credentials and personal
# overrides belong in .env.local or config/env/local.env, both ignored by git.

AETHERNET_ENV=development
NODE_ENV=development
AETHERNET_BASE_DOMAIN=localhost
AETHERNET_PUBLIC_SCHEME=http
AETHERNET_PUBLIC_PORT=8088
AETHERNET_STATIC_CDN_DOMAIN=localhost
AETHERNET_PUBLIC_URL=http://localhost:8088
AETHERNET_API_ENDPOINT=http://localhost:8088/api
AETHERNET_API_CLIENT_ENDPOINT=http://localhost:8088/api
AETHERNET_APP_ENDPOINT=http://localhost:8088
AETHERNET_GATEWAY_ENDPOINT=ws://localhost:8088/gateway
AETHERNET_MEDIA_ENDPOINT=http://localhost:8088/media
AETHERNET_STATIC_CDN_ENDPOINT=http://localhost:8088
AETHERNET_ADMIN_ENDPOINT=http://localhost:8088/admin
AETHERNET_MARKETING_ENDPOINT=http://localhost:8088
AETHERNET_APP_PRODUCT_NAME=AETHERNET
AETHERNET_TRUST_CLIENT_IP_HEADER=true
AETHERNET_CLIENT_IP_HEADER_NAME=x-forwarded-for

AETHERNET_DATABASE_BACKEND=postgres
