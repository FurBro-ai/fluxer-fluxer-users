{
	"name": "aethernet",
	"private": true,
	"scripts": {
		"build": "cargo run -p aethernet-dev -- build",
		"dev": "cargo run -p aethernet-dev -- dev",
		"dev:low-memory": "cargo run -p aethernet-dev -- dev --low-memory",
		"dev:bootstrap": "cargo run -p aethernet-dev -- bootstrap",
		"dev:cassandra:apply": "cargo run -p aethernet-dev -- cassandra apply",
		"dev:cassandra:diff": "cargo run -p aethernet-dev -- cassandra diff",
		"dev:cassandra:verify": "cargo run -p aethernet-dev -- cassandra verify",
		"dev:desktop:build": "cargo run -p aethernet-dev -- desktop build",
		"dev:desktop:install": "cargo run -p aethernet-dev -- desktop install",
		"dev:desktop:canary": "cargo run -p aethernet-dev -- desktop canary",
		"dev:desktop:package": "cargo run -p aethernet-dev -- desktop package",
		"dev:desktop:run": "cargo run -p aethernet-dev -- desktop run",
		"dev:infra:restart": "pnpm dev:infra:stop && pnpm dev:infra:start",
		"dev:infra:start": "cargo run -p aethernet-dev -- infra start",
		"dev:infra:status": "cargo run -p aethernet-dev -- infra status",
		"dev:infra:stop": "cargo run -p aethernet-dev -- infra stop",
		"dev:services": "cargo run -p aethernet-dev -- rust-services",
		"dev:tunnel": "cargo run -p aethernet-dev -- dev --cloudflare-tunnel",
		"dev:tunnel:configure": "cargo run -p aethernet-dev -- tunnel configure",
		"dev:tunnel:env": "cargo run -p aethernet-dev -- tunnel print-env",
		"dev:tunnel:run": "cargo run -p aethernet-dev -- tunnel run",
		"docs:build": "pnpm --filter aethernet_docs build",
		"docs:dev": "pnpm --filter aethernet_docs dev",
		"docs:typecheck": "pnpm --filter aethernet_docs typecheck",
		"i18n:compile": "pnpm --filter aethernet_app i18n:compile && pnpm --filter @aethernet/i18n static:compile && pnpm --filter @aethernet/i18n generate:types",
		"i18n:refresh": "pnpm --filter aethernet_app i18n:refresh",
		"i18n:generate": "pnpm --filter @aethernet/i18n generate:types",
		"i18n:prune:apply": "pnpm --filter @aethernet/i18n prune:apply",
		"i18n:prune:dry": "pnpm --filter @aethernet/i18n prune:dry",
		"i18n:source-sync": "pnpm --filter aethernet_app i18n:extract && pnpm --filter @aethernet/i18n static:extract && pnpm i18n:compile",
		"i18n:typecheck": "pnpm --filter @aethernet/errors --filter @pkgs/email typecheck",
		"i18n:weblate-compile": "pnpm i18n:compile",
		"knip": "cargo run -p aethernet-dev -- knip",
		"lint": "cargo run -p aethernet-dev -- lint",
		"openapi:generate": "pnpm --filter @aethernet/openapi generate",
		"openapi:validate": "pnpm --filter @aethernet/openapi validate",
		"test": "cargo run -p aethernet-dev -- test",
		"typecheck": "cargo run -p aethernet-dev -- typecheck"
	},
	"prettier": {
		"bracketSpacing": false,
		"printWidth": 120,
		"singleQuote": true,
		"tabWidth": 2,
		"useTabs": true
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-react-google-translate": "catalog:",
		"knip": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:"
	},
	"packageManager": "pnpm@10.29.3"
}
